{
  "manifest_version": 3,
  "name": "Tab Killer",
  "version": "1.0",
  "description": "Clean up your tabs at the end of the day safely and effectively.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Killer"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
